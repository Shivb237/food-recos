# Copy to .env.local for local work (never commit that file). On Vercel, set the same names under Project > Settings > Environment Variables.

# Photos. Key restricted to Places API (New) only.
GOOGLE_MAPS_API_KEY=
# Most Google photo requests the site may make per day. Beyond it, cards show their generated look.
PHOTO_DAILY_CAP=150
# Local photo picker only (/dev/photos): its own daily cap.
PICKER_DAILY_CAP=600

# Likes and comments (a free Upstash Redis database; use the REST URL and REST token).
# Leave empty locally and an in-memory stand-in is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: a long secret phrase. Open https://<site>/#admin=<phrase> once on your phone to delete any comment.
ADMIN_TOKEN=

# Optional: only if you add a custom domain (used for the WhatsApp link preview image).
SITE_URL=
