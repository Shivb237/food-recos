{
  "name": "manikonda-picks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-places.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "places:resolve": "tsx --env-file=.env.local scripts/resolve-place-ids.ts",
    "places:coverage": "tsx scripts/coverage-report.ts",
    "brand:images": "tsx scripts/make-brand-images.tsx",
    "preview:prod": "tsx --env-file=.env.local scripts/serve-dist.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "preact": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "preact-render-to-string": "^6.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
